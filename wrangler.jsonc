{
  // Cloudflare: the static prototype, plus a small worker for the view-count API (/api/*)
  "name": "dein-art",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./prototype", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "VIEWS", "class_name": "ViewCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ViewCounter"] }]
}
